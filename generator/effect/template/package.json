{
  "name": "polar-effect",
  "version": "{{ version }}",
  "description": "Unofficial Effect SDK for the Polar API",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=22" },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.mts", "default": "./dist/index.mjs" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }{% for version in ir.versions %},
    "./{{ version.version }}": {
      "import": { "types": "./dist/{{ version.version }}/index.d.mts", "default": "./dist/{{ version.version }}/index.mjs" },
      "require": { "types": "./dist/{{ version.version }}/index.d.cts", "default": "./dist/{{ version.version }}/index.cjs" }
    }{% endfor %}

  },
  "scripts": {
    "build": "tsdown",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "effect": "^4.0.0-rc.114"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "effect": "4.0.0-rc.114",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@11.13.1",
  "homepage": "https://github.com/dan-myles/polar-effect-sdk#readme",
  "bugs": "https://github.com/dan-myles/polar-effect-sdk/issues",
  "publishConfig": { "access": "public" },
  "keywords": ["polar", "sdk", "api", "effect", "typescript"],
  "author": "dan-myles",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dan-myles/polar-effect-sdk.git",
    "directory": "sdk"
  }
}
