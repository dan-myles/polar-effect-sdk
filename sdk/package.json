{
  "name": "polar-effect",
  "version": "0.1.0",
  "description": "Unofficial Effect SDK for the Polar API",
  "keywords": [
    "api",
    "effect",
    "polar",
    "sdk",
    "typescript"
  ],
  "homepage": "https://github.com/dan-myles/polar-effect-sdk#readme",
  "bugs": "https://github.com/dan-myles/polar-effect-sdk/issues",
  "license": "MIT",
  "author": "dan-myles",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dan-myles/polar-effect-sdk.git",
    "directory": "sdk"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./2026-10": {
      "import": {
        "types": "./dist/2026-10/index.d.mts",
        "default": "./dist/2026-10/index.mjs"
      },
      "require": {
        "types": "./dist/2026-10/index.d.cts",
        "default": "./dist/2026-10/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "effect": "4.0.0-rc.114",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "effect": "^4.0.0-rc.114"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.13.1"
}
